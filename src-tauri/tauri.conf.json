{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "s3-wrap",
  "version": "../package.json",
  "identifier": "com.wang.s3-wrap",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "windows": {
        "installMode": "basicUi"
      },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY5NjkxNzVFOUUwN0EzMDUKUldRRm93ZWVYaGRwK2RNWUsxOWw5TEFNVUdFa3phZTRoRnA0OGlqSUZJZm52b2RSamRoTkhRb2sK",
      "endpoints": [
        "https://github.com/A-afflatus/s3-warp/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
